# Copy to app/.env for real (non-demo) mode. Never commit app/.env.
# Demo mode needs none of this: run with DEMO=1 (see README).

APP_PASSWORD=
PORT=8770
HOST=127.0.0.1

# At least one model provider key is required in real mode.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Optional read-only OpenAI admin key: shows real spend from the OpenAI Costs API.
OPENAI_ADMIN_KEY=

# Monthly spending limit of the app, USD.
LIMIT_USD=10
# Table name used in the SQL export.
EXPORT_TABLE=quest_items
# Folder for the SQLite database (default: app/data).
# DATA_DIR=
# 1 if the app runs behind nginx with https.
# TRUST_PROXY=0
